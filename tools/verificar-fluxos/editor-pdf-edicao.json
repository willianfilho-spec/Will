  "fluxos": [
    {
      "nome": "A. Editar texto (PDF com camada de texto): destaca, edita no lugar, fundo amostrado, baixa sem remover",
      "semRedeExterna": true,
      "passos": [
        {"ir": "/"},
        {"enviarArquivo": "#arquivoPdf", "arquivo": "tools/verificar-fluxos/fixtures/edicao-camada-texto.pdf"},
        {"verQuantidade": ".pagina[data-renderizada]", "igual": 1, "tempo": 10000},
        {"verVisivel": "#fEditarTexto"},
        {"verExpressao": "document.querySelector('#fEditarTexto').getBoundingClientRect().left < document.querySelector('#fSelecionar').getBoundingClientRect().left", "_nota": "Editar texto é a primeira ferramenta da barra"},
        {"clicar": "#fEditarTexto"},
        {"verQuantidade": ".linha-detectada", "igual": 3, "_nota": "3 linhas detectadas na camada de texto"},
        {"verQuantidade": "#grupoOcr:not([hidden])", "igual": 1},
        {"passar": "#pagina-1 .sobreposicao", "posicao": [0.3, 0.327]},
        {"verQuantidade": ".linha-detectada.ativa", "igual": 1, "_nota": "passar o mouse destaca a linha"},
        {"captura": "hover"},
        {"clicar": "#pagina-1 .sobreposicao", "posicao": [0.3, 0.327]},
        {"verExpressao": "document.querySelector('.editor-texto')?.value === 'Codigo do item: BETA-2024-XYZ'", "_nota": "o campo abre preenchido com o texto original"},
        {"verExpressao": "document.activeElement === document.querySelector('.editor-texto')"},
        {"verExpressao": "(() => { const tr = s => s === 'transparent' || /rgba\\(.*,\\s*0\\)$/.test(s); const t = document.querySelector('.editor-texto'), c = document.querySelector('.editor-caixa'); return tr(getComputedStyle(t).backgroundColor) && tr(getComputedStyle(c).backgroundColor); })()", "_nota": "caixa de digitação sem fundo opaco"},
        {"verExpressao": "(() => { const t = document.querySelector('.editor-texto'); const k = document.querySelector('#pagina-1').clientWidth / 595.28; return Math.abs(parseFloat(getComputedStyle(t).fontSize) - 30 * k) < 1.5 && getComputedStyle(t).fontWeight === '700'; })()", "_nota": "tamanho 30 pt e negrito vindos da fonte do PDF"},
        {"verExpressao": "document.querySelector('#pFonte').value === 'helvetica' && document.querySelector('#pNegrito').getAttribute('aria-pressed') === 'true'", "_nota": "a fonte do PDF (Helvetica-Bold) é reconhecida e casada com a fonte padrão equivalente"},
        {"verExpressao": "(window.__antes = document.querySelector('.editor-texto').getBoundingClientRect().toJSON(), true)"},
        {"captura": "editor-aberto"},
        {"preencher": ".editor-texto", "valor": "Codigo do item: NOVO-999"},
        {"tecla": "Enter"},
        {"verQuantidade": ".editor-texto", "igual": 0},
        {"verQuantidade": "#pagina-1 .anot[data-tipo=edicao]", "igual": 1},
        {"verExpressao": "document.querySelector('.anot[data-tipo=edicao] .fundo').getAttribute('fill') === '#7a1238'", "_nota": "fundo amostrado ao redor (vinho), não branco"},
        {"verExpressao": "document.querySelector('.anot[data-tipo=edicao] text').getAttribute('fill') === '#ffffff'", "_nota": "cor do texto amostrada (branco)"},
        {"verExpressao": "(() => { const r = document.querySelector('.anot[data-tipo=edicao] text').getBoundingClientRect(), a = window.__antes; return Math.abs(r.left - a.left) < 5 && Math.abs((r.top + r.bottom) / 2 - (a.top + a.bottom) / 2) < 7; })()", "_nota": "WYSIWYG: o texto final fica onde estava o campo de digitação"},
        {"verVisivel": "#linhaRemocao"},
        {"verTexto": "#avisoRemocao", "contem": "continua dentro do arquivo"},
        {"captura": "editado"},
        {"baixar": "#bBaixarPdf", "validar": {"nomeContem": "-editado.pdf", "assinatura": "%PDF", "pdfPaginas": 1, "pdfTextoContem": ["NOVO-999", "BETA-2024-XYZ", "Comunicado da Coordenacao"], "pdfCapturaPagina": 1, "pdfAmostras": [{"pagina": 1, "fx": 0.84, "fy": 0.31, "perto": "#7A1238", "tolerancia": 30}, {"pagina": 1, "fx": 0.85, "fy": 0.33, "perto": "#7A1238", "tolerancia": 30}, {"pagina": 1, "fx": 0.86, "fy": 0.32, "perto": "#7A1238", "tolerancia": 30}, {"pagina": 1, "fx": 0.85, "fy": 0.32, "longe": "#FFFFFF", "tolerancia": 60}, {"pagina": 1, "fx": 0.5, "fy": 0.2, "perto": "#F4EAD5", "tolerancia": 20}]}, "_nota": "sem a opção de remover: texto novo presente, o antigo continua na camada de texto, e a região não ficou branca"},
        {"verTexto": "#aviso", "contem": "continua dentro do arquivo"}
      ]
