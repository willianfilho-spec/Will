        {"verQuantidade": ".anot.selecionada", "igual": 1},
        {"verExpressao": "+document.querySelector('.anot[data-tipo=edicao] .fundo').getAttribute('x') === window.__fx", "_nota": "mover leva só o texto novo; a cobertura fica sobre o texto antigo"},
        {"verExpressao": "document.querySelector('.anot[data-tipo=edicao] text').getBoundingClientRect().left > window.__tx + 40"},
