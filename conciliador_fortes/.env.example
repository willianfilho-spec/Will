# Copie para .env (ou cadastre no painel da plataforma). NUNCA versione o .env com valores reais.

# Obrigatória. Gere com: python scripts/gerar_chave.py  (guarde uma cópia FORA do backup dos dados)
CONCILIADOR_CHAVE=

# Pasta dos dados (SQLite + arquivos). Em plataforma, aponte para um disco/volume PERSISTENTE.
CONCILIADOR_DATA_DIR=/dados

# Primeiro administrador (só age se ainda não houver usuários). Remova a SENHA depois do primeiro acesso.
CONCILIADOR_ADMIN_EMAIL=
CONCILIADOR_ADMIN_NOME=Administrador
CONCILIADOR_ADMIN_SENHA=

# Atrás do proxy da plataforma: IPs confiáveis para X-Forwarded-For ("*" só se o app não for acessível sem o proxy).
FORWARDED_ALLOW_IPS=*

# Opcionais (os padrões já são os seguros). Não altere em produção.
# CONCILIADOR_EXIGIR_2FA=1
# CONCILIADOR_MAX_UPLOAD=20971520
