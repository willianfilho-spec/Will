# Crie uma chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# Confirme no catálogo da sua conta se este modelo está disponível.
GEMINI_MODEL=gemini-2.5-flash

# Limite de tamanho por arquivo enviado, em megabytes.
MAX_UPLOAD_MB=50

# Modelo de embeddings. Confirme o ID e a disponibilidade na documentação oficial do Google
# e no catálogo da sua conta; o padrão abaixo NÃO foi verificado por este projeto.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Tamanho do vetor (valores menores usam menos espaço). Mudar exige reindexar os documentos.
EMBEDDING_DIM=768
# Quantos trechos recuperar por pergunta (1 a 30).
TOP_K=6
